{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aura:contracts:v1:amplifier-spec",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "enum": [
        "amplifier",
        "amplifier_dsp"
      ]
    },
    "io": {
      "type": "object",
      "properties": {
        "inputChannels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "outputChannels": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "inputChannels",
        "outputChannels"
      ],
      "additionalProperties": {}
    },
    "powerPerChannelW": {
      "type": "object",
      "properties": {
        "2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "4": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "8": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "16": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "8"
      ],
      "additionalProperties": {}
    },
    "bridgeable": {
      "type": "boolean"
    },
    "processing": {
      "type": "object",
      "properties": {
        "dsp": {
          "type": "boolean"
        },
        "crossover": {
          "type": "boolean"
        },
        "limiter": {
          "type": "boolean"
        },
        "delayMaxMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "dsp",
        "crossover",
        "limiter"
      ],
      "additionalProperties": {}
    },
    "electrical": {
      "type": "object",
      "properties": {
        "mainsVoltageV": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mainsVoltageV",
        "connectors"
      ],
      "additionalProperties": {}
    },
    "physical": {
      "type": "object",
      "properties": {
        "weightKg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rackUnits": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "weightKg",
        "rackUnits"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "io",
    "powerPerChannelW",
    "bridgeable",
    "processing",
    "electrical",
    "physical"
  ],
  "additionalProperties": {},
  "title": "AmplifierSpec v1",
  "description": "Datasheet de un amplificador/procesador (nodo pa) del catálogo. powerPerChannelW cruzado con la impedancia del parlante conectado resuelve el electricalPowerW de la simulación."
}
