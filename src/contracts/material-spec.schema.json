{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aura:contracts:v1:material-spec",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "absorption": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "125",
          "250",
          "500",
          "1000",
          "2000",
          "4000"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1.2
      },
      "required": [
        "125",
        "250",
        "500",
        "1000",
        "2000",
        "4000"
      ]
    },
    "scattering": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "125",
          "250",
          "500",
          "1000",
          "2000",
          "4000"
        ]
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "required": [
        "125",
        "250",
        "500",
        "1000",
        "2000",
        "4000"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "nrc": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.2
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "category",
    "absorption",
    "scattering",
    "source"
  ],
  "additionalProperties": {},
  "title": "MaterialSpec v1",
  "description": "Coeficientes por banda de octava de un material del catálogo: α (absorción) y s (dispersión). Se asignan por superficie y gobiernan RT60 y la cola reverberante."
}
