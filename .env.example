# Copiar a .env y rellenar. Todo lo de aquí es local: en producción vive en Vercel.

DATABASE_URL="postgresql://usuario:clave@host:5432/postgres"

# Base para `pnpm test:integration`, que CREA Y BORRA filas. Nunca la de desarrollo: si se deja
# vacía los tests se saltan solos, y eso es preferible a que se lleven por delante tus datos.
# Basta con un esquema aparte de la misma base:
#   DATABASE_URL="...?schema=aura_test" pnpm prisma migrate deploy
TEST_DATABASE_URL=""

BETTER_AUTH_SECRET="genera-uno-largo-y-aleatorio"
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Motor de simulación (aura-engine) ----

# mock (default) · mock-full · mock-fail · http
# Los tres primeros no hablan con aura-engine, pero SÍ con /api/internal/jobs de esta misma app:
# los cuatro modos recorren el mismo camino de ingesta, así que un bug de las rutas se ve en mock.
#
#   mock       devuelve canon-01.expected.json TAL CUAL — los números del Apéndice A.1.
#   mock-full  lo amplía con grilla, alertas y recomendaciones derivadas de la sala que se mandó.
#              Es lo único con lo que se puede recorrer la pantalla de resultados entera, pero sus
#              cifras NO son física: sirven para ver la interfaz, no para contrastar nada.
#   mock-fail  el camino de error: el job termina FAILED con su código.
ENGINE_MODE="mock"

# Solo con ENGINE_MODE=http.
ENGINE_URL="http://localhost:8000"

# EL MISMO STRING que ENGINE_SHARED_SECRET en el .env de aura-engine, o ninguna firma cuadrará.
# Hace falta en los tres modos: también el loopback firma sus callbacks.
ENGINE_SHARED_SECRET="dev-secret"

# Origen al que el motor devuelve los callbacks. Si se omite se usa BETTER_AUTH_URL.
# En aura-engine esta misma URL es su ADMIN_URL.
# APP_URL="http://localhost:3000"

# Bearer del cron que caduca jobs sin latido (Sección 08). Sin él la ruta responde 401 siempre,
# que es lo correcto en local: allí no hay cron y nadie debería poder dispararlo.
CRON_SECRET=""

# ---- Secretos del usuario en reposo (ADR-08) ----

# 32 bytes en base64 — genéralo con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cifra las API keys de LLM que guarda cada usuario. Si cambia, las claves ya guardadas dejan de
# descifrarse: la app lo trata como "no hay clave" y el motor vuelve a sus plantillas.
APP_ENCRYPTION_KEY=""
