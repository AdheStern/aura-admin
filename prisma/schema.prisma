// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  projects       Project[]
  projectMembers ProjectMember[]

  status       String? @default("ACTIVE")
  departmentId String?

  managerId String?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ------- Dominio AURA (Sección 4.0 del doc maestro) -------
// Department y la jerarquía manager/subordinados (User.managerId) quedan disponibles
// para instalaciones institucionales; ninguna regla de autorización de AURA v1 depende
// de ellas. departmentId/managerId en User son additionalFields de Better Auth
// (src/lib/auth.ts) — referencias sueltas, sin @relation, para no pelear con la librería.
model Department {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("department")
}

// ------- Dominio AURA: proyectos y escenas (Sección 4.1, Fase 1) -------
// Scene.simulations Simulation[] se omite: el modelo Simulation llega en Fase 5/6.
model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  scenes         Scene[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId])
  @@index([organizationId])
  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("VIEWER") // ProjectRole: OWNER | EDITOR | VIEWER (zod)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

model Scene {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name       String
  signalFlow Json     @default("{}")
  room       Json     @default("{}")
  status     String   @default("DRAFT") // SceneStatus: DRAFT|FLOW_READY|ROOM_READY|SIMULATED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projectId])
  @@map("scene")
}

// ------- Dominio AURA: catálogos (Sección 4.2, Fase 1) -------
// spec es la fuente de verdad del datasheet (validado con zod al ingresar). Las columnas planas
// (brand/model/category, name/category) son solo para filtrar/listar y se derivan SIEMPRE del
// spec ya validado en la action — nunca un input independiente que pueda divergir de él.
model CatalogSpeaker {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: point_source | line_array_element | subwoofer | monitor
  spec        Json // SpeakerSpec v1 (contracts/speaker-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_speaker")
}

model CatalogMaterial {
  id          String   @id @default(cuid())
  name        String // = spec.name
  category    String // = spec.category (texto libre, sin enum — distinto catálogo a catálogo)
  spec        Json // MaterialSpec v1 (contracts/material-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([name])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_material")
}

model CatalogMicrophone {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: dynamic | condenser | ribbon
  spec        Json // MicrophoneSpec v1 (contracts/microphone-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_microphone")
}

model CatalogConsole {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: analog | digital
  spec        Json // ConsoleSpec v1 (contracts/console-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_console")
}

// El nodo del flujo se llama `pa` y el doc lo glosa "(amplificador/procesador)"; la tabla es
// catalog_amplifier porque así la nombra la Sección 4.1. Son el mismo concepto.
model CatalogAmplifier {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: amplifier | amplifier_dsp
  spec        Json // AmplifierSpec v1 (contracts/amplifier-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_amplifier")
}
