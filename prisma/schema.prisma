// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  projects       Project[]
  projectMembers ProjectMember[]
  simulations    Simulation[]
  settings       UserSettings?

  status       String? @default("ACTIVE")
  departmentId String?

  managerId String?

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ------- Dominio AURA (Sección 4.0 del doc maestro) -------
// Department y la jerarquía manager/subordinados (User.managerId) quedan disponibles
// para instalaciones institucionales; ninguna regla de autorización de AURA v1 depende
// de ellas. departmentId/managerId en User son additionalFields de Better Auth
// (src/lib/auth.ts) — referencias sueltas, sin @relation, para no pelear con la librería.
model Department {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("department")
}

// ------- Dominio AURA: proyectos y escenas (Sección 4.1, Fase 1) -------
model Project {
  id             String          @id @default(cuid())
  name           String
  description    String?
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  scenes         Scene[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([ownerId])
  @@index([organizationId])
  @@map("project")
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("VIEWER") // ProjectRole: OWNER | EDITOR | VIEWER (zod)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_member")
}

model Scene {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  signalFlow  Json         @default("{}")
  room        Json         @default("{}") // RoomDocument v1: el borrador del editor 2D, que compila a RoomGeometry (ver 4.2)
  // SceneSimulation v1: ambiente + config que el panel del editor 3D edita ANTES de simular. El doc
  // maestro solo declara dónde vive la config CONGELADA (Simulation.config, Fase 5/6) y RoomGeometry
  // no admite ninguno de los dos, así que el borrador necesitaba columna propia: "a cuántos grados
  // está la sala" y "con qué orden ISM se calcula" no son geometría del recinto.
  simulation  Json         @default("{}")
  status      String       @default("DRAFT") // SceneStatus: DRAFT|FLOW_READY|ROOM_READY|SIMULATED
  simulations Simulation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([projectId])
  @@map("scene")
}

// ------- Dominio AURA: simulaciones (Sección 4.1, Fase 5) -------
// El motor nunca escribe aquí: entrega por callback a /api/internal/jobs/:jobId y esta app sigue
// siendo el único dueño del esquema (Sección 03). `request` guarda el payload entero porque el
// motor es una función pura (ADR-03): con él se reproduce el resultado sin depender del estado
// actual de la escena, que para entonces ya puede haber cambiado.
model Simulation {
  id          String         @id @default(cuid())
  sceneId     String
  scene       Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  requestHash String // sha256 del request SIN jobId/simulationId (cambian por corrida) → dedup
  config      Json // SimulationConfig congelada
  request     Json // SimulationRequest v1 completo (contracts/simulation-request.schema.ts)
  job         SimulationJob?
  results     SimResult[]
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@index([sceneId])
  @@map("simulation")
}

model SimulationJob {
  id           String     @id @default(cuid())
  simulationId String     @unique
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  status       String     @default("QUEUED") // JobStatus: QUEUED|RUNNING|COMPLETED|FAILED|CANCELLED
  progress     Int        @default(0) // 0–100 y monótono: una barra que retrocede parece un fallo
  error        Json?
  startedAt    DateTime?
  finishedAt   DateTime?
  // No está en la Sección 4.1, pero la 08 exige pasar a FAILED:TIMEOUT un job sin latido durante
  // 10 minutos, y sin una marca que cada latido refresque esa regla no se puede implementar.
  updatedAt    DateTime   @updatedAt

  @@index([status])
  @@map("simulation_job")
}

// Una fila por `kind` en vez de un blob único: el resumen se consulta y lista, las grillas solo se
// leen al abrir la vista de resultados.
model SimResult {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  // MIX_ADVICE no viene del motor: lo escribe la app (asesor de mezcla por instrumento).
  kind         String // ResultKind: SUMMARY|SPL_GRID|RT_BANDS|CLARITY_GRID|RECOMMENDATIONS|ALERTS|MIX_ADVICE
  summary      Json? // métricas agregadas consultables
  payload      Json? // datos densos (grillas); el doc manda a storagePath si pasa de 1 MB
  storagePath  String?

  @@index([simulationId, kind])
  @@map("sim_result")
}

// ------- Dominio AURA: preferencias de usuario (Sección 4.1, Fase 6) -------
// La API key del LLM se guarda CIFRADA con AES-256-GCM (ADR-08) y no vuelve al cliente nunca más
// después de guardarse: la UI solo sabe si hay una y sus últimos caracteres. Viaja descifrada a un
// único sitio, el payload de la simulación que la necesita, y ni siquiera se persiste ahí.
//
// units y defaultMode los declara el doc; todavía no los lee nadie (v1 es métrico y el modo vive
// por escena). Están para que el modelo sea el de la §4.1 y no una versión recortada que luego
// nadie recuerde completar.
model UserSettings {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  llmProvider     String? // anthropic | google | deepseek
  llmApiKeyCipher String? // base64(iv ‖ tag ‖ cifrado); nunca sale al cliente
  units           String  @default("metric")
  defaultMode     String  @default("simple")

  @@map("user_settings")
}

// ------- Dominio AURA: catálogos (Sección 4.2, Fase 1) -------
// spec es la fuente de verdad del datasheet (validado con zod al ingresar). Las columnas planas
// (brand/model/category, name/category) son solo para filtrar/listar y se derivan SIEMPRE del
// spec ya validado en la action — nunca un input independiente que pueda divergir de él.
model CatalogSpeaker {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: point_source | line_array_element | subwoofer | monitor
  spec        Json // SpeakerSpec v1 (contracts/speaker-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_speaker")
}

model CatalogMaterial {
  id          String   @id @default(cuid())
  name        String // = spec.name
  category    String // = spec.category (texto libre, sin enum — distinto catálogo a catálogo)
  spec        Json // MaterialSpec v1 (contracts/material-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([name])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_material")
}

model CatalogMicrophone {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: dynamic | condenser | ribbon
  spec        Json // MicrophoneSpec v1 (contracts/microphone-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_microphone")
}

model CatalogConsole {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: analog | digital
  spec        Json // ConsoleSpec v1 (contracts/console-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_console")
}

// Fuentes del nodo `source` (instrumento/voz). El doc dice a la vez que "cada nodo referencia un
// ítem de catálogo" (5.1) y que el espectro sale de una "tabla interna": esta tabla cubre la
// primera mitad —qué fuentes existen y cómo se describen— y el espectro por banda sigue en el
// motor. A diferencia de catalog_material, `name` SÍ es único: no hay dos "Bombo".
model CatalogSource {
  id          String   @id @default(cuid())
  name        String // = spec.name
  category    String // = spec.kind: percussion | strings | keys | vocals
  spec        Json // SourceSpec v1 (contracts/source-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_source")
}

// El nodo del flujo se llama `pa` y el doc lo glosa "(amplificador/procesador)"; la tabla es
// catalog_amplifier porque así la nombra la Sección 4.1. Son el mismo concepto. Su spec es una
// unión discriminada: `processor` cubre los gestores de altavoces, que no entregan potencia.
model CatalogAmplifier {
  id          String   @id @default(cuid())
  brand       String
  model       String
  category    String // = spec.kind: amplifier | amplifier_dsp
  spec        Json // AmplifierSpec v1 (contracts/amplifier-spec.schema.ts)
  specVersion String   @default("1")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
  @@index([spec(ops: JsonbPathOps)], type: Gin)
  @@map("catalog_amplifier")
}
